/* ── QPushButton ─────────────────────────────────────── */
QPushButton {
    background-color: {{bg_panel}};
    color: {{text_primary}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: {{bg_hover}};
    border-color: {{border_hover}};
    color: {{text_primary}};
}
QPushButton:pressed { background-color: {{bg_hover}}; }

/* Aksent (primary) tugma */
QPushButton[accent="true"] {
    background: {{accent}};
    color: {{text_on_accent}};
    border: none;
    font-weight: bold;
    border-radius: 6px;
}
QPushButton[accent="true"]:hover { background: {{accent_hover}}; }

/* Danger tugma */
QPushButton[danger="true"] {
    background-color: {{danger_dim}};
    color: {{danger}};
    border: 1px solid {{danger}};
}
QPushButton[danger="true"]:hover { background-color: {{danger_hover_bg}}; }

/* Kichik tugma */
QPushButton[small="true"] {
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 4px;
}

/* Success (yashil) tugma */
QPushButton[success="true"] {
    background-color: {{success_dim}};
    color: {{success}};
    border: 1px solid {{success}};
    font-weight: bold;
}
QPushButton[success="true"]:hover {
    background-color: {{success}};
    color: {{bg_card}};
}
